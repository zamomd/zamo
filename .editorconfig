root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4
max_line_length = 120

[go.mod]
indent_style = tab

[*.{js,ts,svelte,html,css}]
indent_style = tab
max_line_length = 120

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

[*.json]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
